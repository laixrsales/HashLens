    <string name="onboarding_title">Como funciona</string>
    <string name="onboarding_intro">O HashLens guarda uma prova de quando e por quem cada foto foi registrada, e de quanto ela mudou desde então.</string>
    <string name="onboarding_register_title">Registrar</string>
    <string name="onboarding_register_text">Fotografe pelo app. A foto ganha um registro permanente com a data e a sua carteira, que assina em seu nome.</string>
    <string name="onboarding_verify_title">Verificar</string>
    <string name="onboarding_verify_text">Escolha qualquer imagem para saber se ela está registrada, por quem e quanto mudou desde a original. Não precisa de conta.</string>
    <string name="onboarding_edit_title">Editar</string>
    <string name="onboarding_edit_text">Só fotos registradas, ou cópias idênticas a elas, podem ser editadas. Filtros: brilho, contraste, preto e branco, sépia, desfoque, nitidez, bordas, recorte e rotação. Cada versão fica ligada à original.</string>
    <string name="onboarding_limits">O registro comprova quando e por quem a foto foi registrada, não que a cena retratada seja real.</string>
    <string name="onboarding_test_network">O HashLens usa a Sepolia, uma rede de testes: registrar não custa dinheiro de verdade.</string>
    <string name="onboarding_formats">Aceita JPEG, PNG e WebP. Fotos em HEIC ou HEIF não são aceitas.</string>
