<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Leitura do contrato por JSON-RPC (RegistryReader) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Captura de fotos (CameraX) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Gravação na galeria no Android 8 e 9; a partir do 10 o MediaStore dispensa (GalleryRepository) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <!-- Saber se há uma carteira compatível com WalletConnect instalada (folha "Conectar carteira") -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="wc" />
        </intent>
    </queries>

    <application
        android:name=".HashLensApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HashLens">

        <!--
            Launcher e a volta do app da carteira (hashlens-wc://). Nenhum filtro aceita imagens:
            sem ACTION_SEND nem ACTION_VIEW de image/* (research R16, FR-019).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hashlens-wc" />
            </intent-filter>
        </activity>

        <!-- WorkManager é inicializado sob demanda com a HiltWorkerFactory (HashLensApp) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
