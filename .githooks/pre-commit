#!/usr/bin/env bash
# Bloqueia commits em branches fora do padrão <tipo>/<NNN>-<slug>.
# Ativação (uma vez por clone):  git config core.hooksPath .githooks

branch="$(git symbolic-ref --short HEAD 2>/dev/null)" || exit 0   # HEAD destacado: não valida

case "$branch" in
  main|master) exit 0 ;;
esac

if ! printf '%s' "$branch" | grep -Eq '^(feature|refactor|bugfix|style|chore)/[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$'; then
  echo "✖ Nome de branch inválido: '$branch'" >&2
  echo "  Use <tipo>/<NNN>-<slug>, com tipo = feature | refactor | bugfix | style | chore" >&2
  echo "  Exemplo: feature/002-exportar-metricas" >&2
  echo "  Para renomear a branch atual:  git branch -m <novo-nome>" >&2
  exit 1
fi
exit 0
